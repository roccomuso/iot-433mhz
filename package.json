{
  "name": "iot-433mhz",
  "version": "1.1.0",
  "description": "Node server to handle 433mhz outlets and sensors.",
  "main": "index.js",
  "preferGlobal": true,
  "packageManager": "yarn@1.22.22",
  "bin": {
    "iot-433mhz": "./index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node index.js",
    "test": "yarn run integration_test",
    "integration_test": "NODE_ENV=development mocha --timeout=5000 --exit test/**/*.js",
    "audit": "yarn audit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/roccomuso/iot-433mhz"
  },
  "bugs": {
    "url": "https://github.com/roccomuso/iot-433mhz/issues"
  },
  "keywords": [
    "iot",
    "433mhz",
    "domotic",
    "arduino",
    "raspberry",
    "433",
    "rc-switch",
    "pir"
  ],
  "author": "Rocco Musolino",
  "license": "MIT",
  "dependencies": {
    "@seald-io/nedb": "^4.1.2",
    "@serialport/parser-readline": "^13.0.0",
    "basic-auth": "^2.0.1",
    "chalk": "^4.1.2",
    "console-mirroring": "^1.0.3",
    "consolidate": "^1.0.4",
    "cors": "^2.8.6",
    "debug": "^4.4.3",
    "dotlocal": "^1.1.0",
    "express": "^4.21.2",
    "figlet": "^1.11.3",
    "multer": "^2.2.0",
    "mustache": "^4.2.0",
    "node-webhooks": "^1.4.2",
    "prompt": "^1.3.0",
    "serialport": "^13.0.0",
    "socket.io": "^4.8.3",
    "validator": "^13.15.35",
    "yargs": "^17.7.3"
  },
  "optionalDependencies": {
    "rpi-433": "^2.1.0"
  },
  "devDependencies": {
    "chai": "^6.2.2",
    "mocha": "^11.7.6"
  }
}
